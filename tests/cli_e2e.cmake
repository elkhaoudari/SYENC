file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

function(run expected)
  execute_process(COMMAND "${SYMENC}" ${ARGN}
                  RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "symenc ${ARGN}: expected exit ${expected}, got ${code}\n${err}")
  endif()
endfunction()

function(run_redirect expected in_file out_file)
  execute_process(COMMAND "${SYMENC}" ${ARGN}
                  INPUT_FILE "${in_file}" OUTPUT_FILE "${out_file}"
                  RESULT_VARIABLE code ERROR_VARIABLE err)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "symenc ${ARGN}: expected exit ${expected}, got ${code}\n${err}")
  endif()
endfunction()

function(expect_same_bytes a b what)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${a}" "${b}" RESULT_VARIABLE differ)
  if(differ)
    message(FATAL_ERROR "${what}: files differ (${a} vs ${b})")
  endif()
endfunction()

file(GLOB sources "${DATA_DIR}/hello.*")
list(LENGTH sources source_count)
if(NOT source_count EQUAL 6)
  message(FATAL_ERROR "expected 6 sample sources, found ${source_count}")
endif()
foreach(src IN LISTS sources)
  get_filename_component(name "${src}" NAME)
  run(0 encode "${src}" "${WORK_DIR}/${name}.sym")
  run(0 decode "${WORK_DIR}/${name}.sym" "${WORK_DIR}/${name}.back")
  expect_same_bytes("${src}" "${WORK_DIR}/${name}.back" "round trip of ${name}")
  run_redirect(0 "${src}" "${WORK_DIR}/${name}.piped.sym" encode - -)
  expect_same_bytes("${WORK_DIR}/${name}.sym" "${WORK_DIR}/${name}.piped.sym" "file vs pipe for ${name}")
  run_redirect(0 "${WORK_DIR}/${name}.sym" "${WORK_DIR}/${name}.piped.back" decode - -)
  expect_same_bytes("${src}" "${WORK_DIR}/${name}.piped.back" "pipe round trip of ${name}")
endforeach()

file(WRITE "${WORK_DIR}/nuls.sym" "SAWSAW")
run(0 decode "${WORK_DIR}/nuls.sym" "${WORK_DIR}/nuls.bin")
file(READ "${WORK_DIR}/nuls.bin" nul_hex HEX)
if(NOT nul_hex STREQUAL "0000")
  message(FATAL_ERROR "expected bytes 00 00, got ${nul_hex}")
endif()
file(WRITE "${WORK_DIR}/crlf.sym" "JIGSAWJIGSAW")
run(0 decode "${WORK_DIR}/crlf.sym" "${WORK_DIR}/crlf.bin")
file(READ "${WORK_DIR}/crlf.bin" crlf_hex HEX)
if(NOT crlf_hex STREQUAL "3232")
  message(FATAL_ERROR "expected 32 32, got ${crlf_hex}")
endif()

file(WRITE "${WORK_DIR}/empty" "")
run(0 encode "${WORK_DIR}/empty" "${WORK_DIR}/empty.sym")
run(0 decode "${WORK_DIR}/empty" "${WORK_DIR}/empty.out")
file(SIZE "${WORK_DIR}/empty.sym" size_a)
file(SIZE "${WORK_DIR}/empty.out" size_b)
if(NOT size_a EQUAL 0 OR NOT size_b EQUAL 0)
  message(FATAL_ERROR "empty files must produce 0-byte outputs")
endif()

run(2)
run(2 frobnicate a b)
run(2 encode only-one-argument)
run(3 encode "${WORK_DIR}/does-not-exist" "${WORK_DIR}/x")
run(3 encode "${WORK_DIR}/empty" "${WORK_DIR}/no/such/dir/out")
file(WRITE "${WORK_DIR}/bad.sym" "JIGX")
run(1 decode "${WORK_DIR}/bad.sym" "${WORK_DIR}/bad.out")
file(WRITE "${WORK_DIR}/nonascii.txt" "café")
run(1 encode "${WORK_DIR}/nonascii.txt" "${WORK_DIR}/nonascii.out")

if(EXISTS "${WORK_DIR}/bad.out" OR EXISTS "${WORK_DIR}/nonascii.out")
  message(FATAL_ERROR "a failed run created an output file")
endif()
file(WRITE "${WORK_DIR}/keep.txt" "KEEP")
run(1 decode "${WORK_DIR}/bad.sym" "${WORK_DIR}/keep.txt")
file(READ "${WORK_DIR}/keep.txt" kept)
if(NOT kept STREQUAL "KEEP")
  message(FATAL_ERROR "existing destination was modified by a failed run: ${kept}")
endif()
file(GLOB leftovers "${WORK_DIR}/*.symenc-tmp-*")
if(leftovers)
  message(FATAL_ERROR "temporary files left behind: ${leftovers}")
endif()

execute_process(COMMAND "${SYMENC}" decode - -
                INPUT_FILE "${WORK_DIR}/bad.sym" OUTPUT_VARIABLE stdout_text RESULT_VARIABLE code)
if(NOT code EQUAL 1 OR NOT stdout_text STREQUAL "")
  message(FATAL_ERROR "failed decode must exit 1 with empty stdout (exit ${code}, stdout '${stdout_text}')")
endif()

message(STATUS "cli_e2e: all checks passed")
